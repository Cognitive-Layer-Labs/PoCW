{
  "name": "pocw-engine",
  "version": "1.0.0",
  "description": "PoCW (Proof of Cognitive Work) engine: content ingestion, knowledge-graph extraction and adaptive IRT testing over HTTP.",
  "main": "dist/server.js",
  "license": "MIT",
  "type": "commonjs",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cognitive-Layer-Labs/PoCW.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx node_modules/mocha/bin/mocha.js --require tests/setup.ts 'tests/**/*.test.ts'"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "dotenv": "16.4.5",
    "express": "4.22.1",
    "express-rate-limit": "^8.3.2",
    "falkordb": "^6.6.2",
    "ioredis": "^5.4.1",
    "js-yaml": "4.1.1",
    "jsdom": "^27.4.0",
    "openai": "4.77.4",
    "pdf-parse": "^1.1.1",
    "youtube-transcript": "^1.2.1"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5",
    "diff": ">=8.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/chai": "4.3.20",
    "@types/express": "4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^27.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/sinon": "^21.0.0",
    "chai": "4.5.0",
    "mocha": "^11.1.0",
    "nock": "^14.0.10",
    "sinon": "^21.0.1",
    "ts-node-dev": "2.0.0",
    "tsx": "^4.21.0",
    "typescript": "5.6.3"
  }
}
