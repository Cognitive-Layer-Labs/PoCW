# -----------------------------------------------------------------------------
# PoCW engine — environment template. Copy to .env and fill in the secrets.
# Generate secrets with e.g.:  openssl rand -hex 32   (hex keeps them URL-safe)
# -----------------------------------------------------------------------------

# ── LLM provider ─────────────────────────────────────────────────────────────
# OpenRouter key used for KG extraction, question generation and grading.
OPENROUTER_API_KEY=""

# ── HTTP API ─────────────────────────────────────────────────────────────────
# Bearer token required on every /api/* route (except /api/admin/*).
# Optional in local dev (empty = open); the engine refuses to start without it when
# NODE_ENV=production.
POCW_API_KEY=""
# Separate bearer token for /api/admin/* (visibility, delete, reindex, wipe).
# Empty = admin API disabled (403).
ADMIN_API_KEY=""
# Express "trust proxy": number of proxy hops in front of the engine that append to
# X-Forwarded-For (e.g. 1 when the landing app forwards the client IP), or an
# Express trust-proxy expression ("loopback", "10.0.0.0/8", ...). Empty = ignore XFF.
TRUST_PROXY=""
# Let HTTP callers choose the LLM via config.model ("true"). Off by default: the model
# decides cost, so only the models in ai-config.yml are used.
ALLOW_MODEL_OVERRIDE=""
# Browser origin allowed via CORS. Leave empty when browsers never call the engine
# directly (the standard setup: the landing proxies server-side).
CORS_ORIGIN=""
PORT=3000
# SQLite content index path (default: ./data/pocw.db).
POCW_DB_PATH=""

# ── Datastores (native runs; docker-compose.yml sets hosts/URLs itself) ──────
FALKORDB_HOST="localhost"
FALKORDB_PORT=6379
FALKORDB_PASSWORD=""
FALKORDB_GRAPH="pocw"
REDIS_URL="redis://localhost:6380/1"

# ── docker-compose.yml only ──────────────────────────────────────────────────
# Engine is published on 127.0.0.1:${ENGINE_PORT} only.
ENGINE_PORT=3000
# Redis password (required by compose). Must be URL-safe: it is embedded in REDIS_URL.
REDIS_PASSWORD=""
# FALKORDB_PASSWORD above is also required by compose.
FALKORDB_MAXMEMORY="512mb"
FALKORDB_MEM_LIMIT="640m"
REDIS_MAXMEMORY="128mb"
REDIS_MEM_LIMIT="192m"
ENGINE_MEM_LIMIT="768m"
